    <decisions>
        <name>ValidAccountRecordTypeCheck</name>
        <label>ValidAccountRecordTypeCheck</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ErrorMessage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ValidRecordTypeCombination</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>validAccountRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>ValidRecordTypeCombination</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>validAccountRecordType</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
OR({!GetParentAccountRecord.RecordType.DeveloperName}==&apos;Facility&apos;,
{!GetParentAccountRecord.RecordType.DeveloperName}==&apos;DrinkingWaterSystem&apos;,
{!GetParentAccountRecord.RecordType.DeveloperName}==&apos;DrinkingWaterSourceIntake&apos;),
{!$Record.RecordType.DeveloperName}==&apos;PHOCSNonDairyTransactionFee&apos;
    ),
AND(
    {!GetParentAccountRecord.RecordType.DeveloperName}==&apos;PHOCSDairyFacility&apos;,
    {!$Record.RecordType.DeveloperName}==&apos;PHOCSTransactionFee&apos;
    )
)</expression>
    </formulas>
    <interviewLabel>PHOCSRTFValidAccountRecordTypeCheck {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHOCSRTFValidAccountRecordTypeCheck</label>
    <processMetadataValues>
        <name>BuilderType</name>
