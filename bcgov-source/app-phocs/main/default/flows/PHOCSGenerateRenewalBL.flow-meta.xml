<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Exemption_To_Collection</name>
        <label>Add Exemption To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>colExemptionBLAs</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Exemption_BLAs</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Exemption_BLAs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_New_BL_To_Exemption</name>
        <label>Assign New BL To Exemption</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Exemption_BLAs.LicensePermitNameId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>VarNewBL</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Exemption_To_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_New_BL_Id</name>
        <label>Store New BL Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VarNewBL</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CreateBusinessLicenseRecord.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_License_Type_is_Drinking_Water_Operating_Permit</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_Old_BL_Id</name>
        <label>Store Old BL Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOldBLId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_BLA.LicensePermitName.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Renewal_Year</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Whether_Exemptions_Exist</name>
        <label>Check Whether Exemptions Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>UpdateBLA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Exemptions_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_old_Exemptions_BLA</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Exemption_BLAs</targetReference>
            </connector>
            <label>Exemptions Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Renewal_Year</name>
        <label>Has Renewal Year</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No BLA or Renewal Year</defaultConnectorLabel>
        <rules>
            <name>Renewal_Year_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_BLA.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RenewalYear__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetPermitRecordTypeId</targetReference>
            </connector>
            <label>Renewal Year Populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_License_Type_is_Drinking_Water_Operating_Permit</name>
        <label>Is License Type is Drinking Water Operating Permit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>UpdateBLA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_BLA.LicenseType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Drinking Water Operating Permit</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Exemptions_RecordTypeID</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <description>EHIS-5070 Generates a renewal Business Licence when a Renewal Regulatory Transaction Fee is paid in full.
EHIS-5087 - Relink Exemption BLA from Prior BL to Renewed BL</description>
    <environments>Default</environments>
    <formulas>
        <name>BLContactId</name>
        <dataType>String</dataType>
        <expression>IF({!Get_BLA.LicenseType.Name}==&apos;BCCDC Dairy Worker Licence&apos;, {!Get_BLA.ApplicantId}, null)</expression>
    </formulas>
    <formulas>
        <name>BLName</name>
        <dataType>String</dataType>
        <expression>{!Get_BLA.Account.Name} + &apos; &apos; + {!Get_BLA.LicenseType.Name}</expression>
    </formulas>
    <formulas>
        <name>businessEntityAccount</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!Get_BLA.Account.ParentAccount__c})) &amp;&amp;
  {!Get_BLA.Account.ParentAccount__r.RecordType.DeveloperName} = &quot;Business_Entity&quot;,
  {!Get_BLA.Account.ParentAccount__c},

  IF(
     NOT(ISBLANK({!Get_BLA.Account.ParentAccount__r.ParentAccount__c})) &amp;&amp;
     {!Get_BLA.Account.ParentAccount__r.ParentAccount__r.RecordType.DeveloperName} = &quot;Business_Entity&quot;,
     {!Get_BLA.Account.ParentAccount__r.ParentAccount__c},

    IF(
       NOT(ISBLANK({!Get_BLA.Account.ParentAccount__r.ParentAccount__r.ParentAccount__c})) &amp;&amp;
       {!Get_BLA.Account.ParentAccount__r.ParentAccount__r.ParentAccount__r.RecordType.DeveloperName} = &quot;Business_Entity&quot;,
       {!Get_BLA.Account.ParentAccount__r.ParentAccount__r.ParentAccount__c},
        NULL
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>PeriodEndValue</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(DATE(VALUE({!$Record.RenewalYear__c}), 3, 31)) &amp; &quot; 08:00:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>PeriodStartValue</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(DATE(VALUE({!$Record.RenewalYear__c}) - 1, 4, 1)) &amp; &quot; 08:00:00&quot;)</expression>
    </formulas>
    <interviewLabel>PHOCS Generate Renewal BL {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHOCS Generate Renewal BL</label>
    <loops>
        <name>Loop_Exemption_BLAs</name>
        <label>Loop Exemption BLAs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_old_Exemptions_BLA</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_New_BL_To_Exemption</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Exemption_BLAs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateBusinessLicenseRecord</name>
        <label>Create Business License Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Store_New_BL_Id</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>businessEntityAccount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>Get_BLA.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>BLContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>BLName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PeriodEnd</field>
            <value>
                <elementReference>PeriodEndValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PeriodStart</field>
            <value>
                <elementReference>PeriodStartValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>GetPermitRecordTypeId.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RegulatoryAuthorizationTypeId</field>
            <value>
                <elementReference>Get_BLA.LicenseTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>BusinessLicense</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_BLA</name>
        <label>Get BLA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Store_Old_BL_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentRecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BusinessLicenseApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Exemptions_RecordTypeID</name>
        <label>Get Exemptions RecordTypeID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_old_Exemptions_BLA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PHOCSExemptions</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BusinessLicenseApplication</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_old_Exemptions_BLA</name>
        <label>Get old Exemptions BLA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Whether_Exemptions_Exist</targetReference>
        </connector>
        <filterLogic>(1 AND 2 AND 3) AND (4 OR 5) AND (6 OR 7)</filterLogic>
        <filters>
            <field>LicensePermitNameId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOldBLId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Exemptions_RecordTypeID.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>ClosureReason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Granted</stringValue>
            </value>
        </filters>
        <filters>
            <field>ClosureReason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Granted - Renewed</stringValue>
            </value>
        </filters>
        <filters>
            <field>EffectiveTo__c</field>
            <operator>EqualTo</operator>
        </filters>
        <filters>
            <field>EffectiveTo__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>CreateBusinessLicenseRecord.PeriodStart</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>BusinessLicenseApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetPermitRecordTypeId</name>
        <label>Get Permit RecordType Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Inactivate_Facility_BLs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BusinessLicense</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PHOCSPermitLicense</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Inactivate_Facility_BLs</name>
        <label>Inactivate Facility BLs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateBusinessLicenseRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_BLA.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RegulatoryAuthorizationTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_BLA.LicenseTypeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetPermitRecordTypeId.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PeriodEnd</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </inputAssignments>
        <object>BusinessLicense</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Exemption_BLAs</name>
        <label>Update Exemption BLAs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UpdateBLA</targetReference>
        </connector>
        <inputReference>colExemptionBLAs</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateBLA</name>
        <label>Update BLA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_BLA.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>LicensePermitNameId</field>
            <value>
                <elementReference>CreateBusinessLicenseRecord</elementReference>
            </value>
        </inputAssignments>
        <object>BusinessLicenseApplication</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_BLA</targetReference>
        </connector>
        <filterFormula>AND(
  {!$Record.RecordType.DeveloperName} = &apos;PHOCSNonDairyTransactionFee&apos;,
  ISPICKVAL({!$Record.FeeType__c}, &apos;Renewal&apos;),
  ISPICKVAL({!$Record.Status__c}, &apos;Paid&apos;),
  OR(
    ISPICKVAL(PRIORVALUE({!$Record.Status__c}), &apos;Due&apos;),
    ISPICKVAL(PRIORVALUE({!$Record.Status__c}), &apos;Partially Paid&apos;)
  )
)</filterFormula>
        <object>RegulatoryTrxnFee</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>colExemptionBLAs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>BusinessLicenseApplication</objectType>
    </variables>
    <variables>
        <name>varExemptionBLA</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>BusinessLicenseApplication</objectType>
    </variables>
    <variables>
