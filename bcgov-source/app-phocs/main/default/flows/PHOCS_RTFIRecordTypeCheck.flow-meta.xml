            <value>
                <elementReference>$Record.RegulatoryTrxnFeeId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RegulatoryTrxnFee</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetRTFRecordDetails</targetReference>
        </connector>
        <filterFormula>OR (
    ({!$Record.RecordType.DeveloperName} == &apos;PHOCSRegulatoryTransactionFeeItem&apos;) ,
     ({!$Record.RecordType.DeveloperName}==&apos;PHOCSNonDairyTransactionFeeItem&apos;)
     )</filterFormula>
        <object>RegulatoryTrxnFeeItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
