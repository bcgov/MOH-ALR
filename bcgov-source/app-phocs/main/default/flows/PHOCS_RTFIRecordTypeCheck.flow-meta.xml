            <errorMessage>{!ErrorMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Decision_1</name>
        <label>ValidateRecordTypeAssociation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ValidRTMatch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isMatchingRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Custom_Error_Message_1</targetReference>
            </connector>
            <label>ValidMatch</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>isMatchingRecordType</name>
        <dataType>Boolean</dataType>
        <expression>OR (
   AND( 
({!$Record.RecordType.DeveloperName} == &apos;PHOCSRegulatoryTransactionFeeItem&apos;) , 
({!GetRTFRecordDetails.RecordType.DeveloperName}==&apos;PHOCSTransactionFee&apos;)
),
  AND(   
({!$Record.RecordType.DeveloperName}==&apos;PHOCSNonDairyTransactionFeeItem&apos;),
({!GetRTFRecordDetails.RecordType.DeveloperName}==&apos;PHOCSNonDairyTransactionFee&apos;)
)
     )</expression>
    </formulas>
    <interviewLabel>PHOCS_RTFIRecordTypeCheck {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHOCS_RTFIRecordTypeCheck</label>
    <processMetadataValues>
