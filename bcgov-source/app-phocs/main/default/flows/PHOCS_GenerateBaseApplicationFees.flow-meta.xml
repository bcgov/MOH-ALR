    <formulas>
        <name>isBLMetConditions</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  AND(
           {!LoopThroughMetadataToGetLIcenseTypes.MetricType__c} = &apos;NoofConnections__c&apos;,
           TEXT({!$Record.Account.NoofConnections__c}) = {!LoopThroughMetadataToGetLIcenseTypes.ConnectionString__c}
           ),
AND(
       {!LoopThroughMetadataToGetLIcenseTypes.MetricType__c} = &apos;NumberOfSeats__c&apos;,
       TEXT({!$Record.Account.Type})= &quot;Food&quot;,
        NOT(ISBLANK(TEXT({!$Record.Account.NumberOfSeats__c}))),  
       TEXT({!$Record.Account.NumberOfSeats__c})={!LoopThroughMetadataToGetLIcenseTypes.SeatsString__c}   
       ),
AND(
       {!LoopThroughMetadataToGetLIcenseTypes.MetricType__c} = &apos;CategoryL2__c&apos;,
      TEXT({!$Record.Account.Type})= &quot;Food&quot;,
      NOT(ISBLANK(TEXT({!$Record.Account.CategoryL2__c}))),
      {!LoopThroughMetadataToGetLIcenseTypes.CategoryString__c}=TEXT({!$Record.Account.CategoryL2__c})
       ),
AND(
       {!LoopThroughMetadataToGetLIcenseTypes.MetricType__c} = &apos;PoolAream2__c&apos;,
      TEXT({!$Record.Account.Type})= &quot;Recreational water&quot;,     
       PoolArea &gt; 0,  
 {!LoopThroughMetadataToGetLIcenseTypes.PoolMinArea__c} &lt; PoolArea, 
    {!LoopThroughMetadataToGetLIcenseTypes.PoolAreaString__c}  &gt; PoolArea 
       )
)</expression>
    </formulas>
    <formulas>
