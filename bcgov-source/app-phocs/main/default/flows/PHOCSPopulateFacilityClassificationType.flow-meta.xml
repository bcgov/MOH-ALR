<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>EHIS-4803- Flow to auto populate Facility Classification Type for LWS based on the Type</description>
    <environments>Default</environments>
    <formulas>
        <name>ClassificationTypeFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.Account.PHOWaterSystemSizeCategory__c} = &apos;Small Water System 50-500&apos;,    &apos;SWS&apos;,
    IF(
        {!$Record.Account.PHOWaterSystemSizeCategory__c} = &apos;Large Water System &gt;100,000&apos;,
        CASE( {!$Record.Type__c},
            &apos;Treatment&apos;, &apos;WT&apos;,
            &apos;Distribution&apos;, &apos;WD&apos;,
            &apos;&apos;
        ),
        &apos;&apos;
    )
)</expression>
    </formulas>
    <interviewLabel>EHIS-4803- Flow to auto populate Facility Classification Type based on the Type {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHOCS Populate Facility Classification Type for LWS</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>populate Facility Classification Type</description>
        <name>UpdateTriggeringAssetrecord</name>
        <label>Update Triggering Asset record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>FacilityClassificationType__c</field>
            <value>
                <elementReference>ClassificationTypeFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UpdateTriggeringAssetrecord</targetReference>
        </connector>
        <filterFormula>OR(
AND( ISNEW(), NOT(ISBLANK(TEXT({!$Record.Type__c}))) ),
ISCHANGED({!$Record.Type__c})
)</filterFormula>
        <object>Asset</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
