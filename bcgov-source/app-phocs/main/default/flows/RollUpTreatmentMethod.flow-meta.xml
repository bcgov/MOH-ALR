                <elementReference>$Record.Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CategoryL2__c</field>
            <value>
                <elementReference>$Record.PoolType__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CategoryL3__c</field>
            <value>
                <elementReference>$Record.PoolSubtype__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Record_Type</targetReference>
        </connector>
        <object>Asset</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
