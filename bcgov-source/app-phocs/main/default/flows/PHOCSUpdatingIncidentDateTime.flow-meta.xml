<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_IncidentDate</name>
        <label>Set IncidentDate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.IncidentDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.ReceivedDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_the_PHOCS_Recordtype</name>
        <label>Check the PHOCS Recordtype</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsPHOCSPublicRequestInquiryRT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PHOCSPublicRequestInquiry</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_IncidentDate</targetReference>
            </connector>
            <label>IsPHOCSPublicRequestInquiryRT</label>
        </rules>
    </decisions>
    <description>Set System-required field IncidentDate value as ReceivedDate to avoid creation error on PHOCS specific record type on PublicComplaint object and adding the RT check to decision element.</description>
    <environments>Default</environments>
    <interviewLabel>PHOCS Updating Incident Date/Time {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHOCS Updating Incident Date/Time</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_the_PHOCS_Recordtype</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IncidentDate</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PublicComplaint</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>