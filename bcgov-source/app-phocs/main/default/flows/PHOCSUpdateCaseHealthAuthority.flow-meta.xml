<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Populate_Case_Type_from_Account_Type</name>
        <label>Populate Case Type from Account Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.Type</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Case_Account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Case_Account</name>
        <label>Check Case Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Clear_Case_Health_Authority</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Account_Is_Set</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.AccountId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_Insert</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_Account</targetReference>
            </connector>
            <label>Account Is Set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_PHOCS_Advisories_RecordType</name>
        <label>Check PHOCS Advisories RecordType</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Case_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_PHOCS_Advisories</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PHOCSWaterAdvisories</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Drinking Water</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Recreational Water</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Case_Type_from_Account_Type</targetReference>
            </connector>
            <label>Is PHOCS Advisories</label>
        </rules>
    </decisions>
    <description>As part of EHIS-5127 - Updated the All PHOCS Case RecordTypes
As part of EHIS-5095 - Auto populate Case type fields from account type only for Drinking and recreation water Types</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Insert</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PHOCS Update Case Health Authority {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PHOCS Update Case Health Authority</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case_Account</name>
        <label>Get Case Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Case_Health_Authority</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Clear_Case_Health_Authority</name>
        <label>Clear Case Health Authority</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HealthAuthority__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Case_Health_Authority</name>
        <label>Set Case Health Authority</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HealthAuthority__c</field>
            <value>
                <elementReference>Get_Case_Account.HealthAuthority__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_PHOCS_Advisories_RecordType</targetReference>
        </connector>
        <filterFormula>OR(
    {!$Record.RecordType.DeveloperName} = &quot;PHOCSComplaint&quot;,
    {!$Record.RecordType.DeveloperName} = &quot;PHOCSReportableIncident&quot;,
    {!$Record.RecordType.DeveloperName} = &quot;PHOCSWaterAdvisories&quot;,
    {!$Record.RecordType.DeveloperName} = &quot;PHOCSRequestsInquiries&quot;,
    {!$Record.RecordType.DeveloperName} = &quot;PHOCSEvent&quot;,
    {!$Record.RecordType.DeveloperName} = &quot;PHOCSFacilityEnquiry&quot;,
    {!$Record.RecordType.DeveloperName} = &quot;PHOCFoodRecall&quot;
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
