<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>EHIS-4616: On an intake&apos;s category/status change, recalculates its AAR-linked Drinking Water System&apos;s Water Source Category.</description>
    <environments>Default</environments>
    <interviewLabel>Account Populate Water Source Category {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Populate Water Source Category</label>
    <loops>
        <name>Loop_Linked_DWS</name>
        <label>Loop Linked DWS</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <collectionReference>Get_Linked_DWS</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Call_Recalculate</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Linked_DWS</name>
        <label>Get Linked DWS</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Linked_DWS</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>RelatedAccountRecordType__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DrinkingWaterSystem</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccountAccountRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Linked_DWS</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.RecordType.DeveloperName} = &quot;DrinkingWaterSourceIntake&quot;,
    OR(
        ISNEW(),
        ISCHANGED({!$Record.CategoryL1__c}),
        ISCHANGED({!$Record.CategoryL2__c}),
        ISCHANGED({!$Record.CategoryL3__c}),
        ISCHANGED({!$Record.Status__c})
    )
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_Recalculate</name>
        <label>Call Recalculate</label>
        <locationX>264</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Loop_Linked_DWS</targetReference>
        </connector>
        <flowName>PHOCS_Recalculate_Water_Source_Category</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>Loop_Linked_DWS.RelatedAccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
