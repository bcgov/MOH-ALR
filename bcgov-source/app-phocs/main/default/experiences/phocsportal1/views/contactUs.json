      "componentAttributes" : {
        "richTextValue" : "<div style=\"font-family: Arial, sans-serif; max-width: 800px;\">\n\n    <!-- Fraser Health -->\n    <div style=\"margin-bottom: 40px;\">\n        <h2 style=\"margin:0; color:#222; font-size:22px; font-weight:bold;\">Fraser Health</h2>\n        <div style=\"width:35px; height:4px; background:#f2b400; margin:8px 0 12px 0;\"></div>\n        <div><a href=\"https://www.fraserhealth.ca/\" target=\"_blank\"  style=\"color:#0070d2; font-size:16px;\">Visit Website</a></div>\n        <div style=\"margin-top:6px;\"><a href=\"https://www.fraserhealth.ca/about-us/contact-us\" target=\"_blank\" style=\"color:#0070d2; font-size:16px;\">Contact</a></div>\n    </div>\n\n    <!-- Interior Health -->\n    <div style=\"margin-bottom: 40px;\">\n        <h2 style=\"margin:0; color:#222; font-size:22px; font-weight:bold;\">Interior Health</h2>\n        <div style=\"width:35px; height:4px; background:#f2b400; margin:8px 0 12px 0;\"></div>\n        <div><a href=\"https://www.interiorhealth.ca/\" target=\"_blank\" style=\"color:#0070d2; font-size:16px;\">Visit Website</a></div>\n        <div style=\"margin-top:6px;\"><a href=\"https://www.interiorhealth.ca/about-ih/contact-information\" target=\"_blank\" style=\"color:#0070d2; font-size:16px;\">Contact</a></div>\n    </div>\n\n    <!-- Island Health -->\n    <div style=\"margin-bottom: 40px;\">\n        <h2 style=\"margin:0; color:#222; font-size:22px; font-weight:bold;\">Island Health</h2>\n        <div style=\"width:35px; height:4px; background:#f2b400; margin:8px 0 12px 0;\"></div>\n        <div><a href=\"https://www.islandhealth.ca/\" target=\"_blank\" style=\"color:#0070d2; font-size:16px;\">Visit Website</a></div>\n        <div style=\"margin-top:6px;\"><a href=\"https://www.islandhealth.ca/contact\" target=\"_blank\" style=\"color:#0070d2; font-size:16px;\">Contact</a></div>\n    </div>\n\n    <!-- Northern Health -->\n    <div style=\"margin-bottom: 40px;\">\n        <h2 style=\"margin:0; color:#222; font-