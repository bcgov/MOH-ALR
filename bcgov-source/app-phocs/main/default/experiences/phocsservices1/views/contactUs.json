ze:16px;\">Contact</a></div>\n    </div>\n\n    <!-- Northern Health -->\n    <div style=\"margin-bottom: 40px;\">\n        <h2 style=\"margin:0; color:#222; font-size:22px; font-weight:bold;\">Northern Health</h2>\n        <div style=\"width:35px; height:4px; background:#f2b400; margin:8px 0 12px 0;\"></div>\n        <div><a href=\"https://www.northernhealth.ca/\" target=\"_blank\" style=\"color:#0070d2; text-decoration:underline; font-size:16px;\">Visit Website</a></div>\n        <div style=\"margin-top:6px;\"><a href=\"https://www.northernhealth.ca/services\" target=\"_blank\" style=\"color:#0070d2; text-decoration:underline; font-size:16px;\">Contact</a></div>\n    </div>\n\n    <!-- Vancouver Coastal Health -->\n    <div style=\"margin-bottom: 40px;\">\n        <h2 style=\"margin:0; color:#222; font-size:22px; font-weight:bold;\">Vancouver Coastal Health</h2>\n        <div style=\"width:35px; height:4px; background:#f2b400; margin:8px 0 12px 0;\"></div>\n        <div><a href=\"https://www.vch.ca/en/health-topics/health-protection-permits-and-licensing\" target=\"_blank\" style=\"color:#0070d2; text-decoration:underline; font-size:16px;\">Visit Website</a></div>\n        <div style=\"margin-top:6px;\"><a href=\"https://www.vch.ca/en/service/health-protection-offices\" target=\"_blank\" style=\"color:#0070d2; text-decoration:underline; font-size:16px;\">Contact</a></div>\n    </div>\n\n</div>"
