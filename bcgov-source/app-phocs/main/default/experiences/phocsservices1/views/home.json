        "richTextValue" : "<div style=\"margin:auto;  \">\n\n<!-- Heading Section -->\n    <div style=\"padding:20px 0 10px 10px;\">\n        <h1 style=\"margin:0;\"><b>Health Inspection Reports</b></h1>\n <!-- Yellow line -->\n    \t<div style=\"width:25px; height:4px; background-color:#FFC107; margin:6px 0 10px 0;\"></div>        <br/>\n        <p style=\"margin:0; color: #000000; font-size :14px\">Environmental Health, Licensing, and Drinking Water Officers regularly inspect facilities for health regulation compliance. Inspections occur routinely and following a complaint. Each visit generates an inspection report for the operator confirming compliance or listing deficiencies to address.</p> <br/>\n        <p style=\"margin:0; color: #000000; font-size :14px\">Select a program area to find facilities in B.C. and view their inspection reports.</p>\n    </div>\n \n <!-- Button Grid -->\n<div class=\"slds-grid slds-wrap\">\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=food&OWL=false\" class=\"slds-button slds-button_brand  custom-btn\"  style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Food</b></a>\n\n</div>\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=childcare&OWL=false\" class=\"slds-button slds-button_brand  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Child Care</b></a>\n\n</div>\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=residentialcare&OWL=false\" class=\"slds-button slds-button_brand  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Residential Care</b></a>\n\n</div>\n\n\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=personalservices&OWL=false\" class=\"slds-button slds-button_neutral  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96;border-color:#1a5a96\"><b>Personal Services</b></a>\n\n</div>\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=childcare&OWL=true\" class=\"slds-button slds-button_neutral  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Child Care (OWL)</b></a>\n\n</div>\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=residentialcare&OWL=true\" class=\"slds-button slds-button_neutral  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Residential Care (OWL)</b></a>\n\n</div>\n\n\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=tobaccovapour&OWL=false\" class=\"slds-button slds-button_outline-brand  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Tobacco and Vapour</b></a>\n\n</div>\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=recreationalwater&OWL=false\" class=\"slds-button slds-button_outline-brand  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Recreational Water</b></a>\n\n</div>\n\n<div class=\"slds-size_1-of-1 slds-medium-size_1-of-3 slds-p-around_small\">\n\n<a href=\"/phocsservices/s/facility-list?PA=drinkingwatersystem&OWL=false\" class=\"slds-button slds-button_outline-brand  custom-btn\" style=\"width:250px;background-color:white;color:#003366;width:100%;font-size :16px;border-color:#1a5a96\"><b>Drinking Water</b></a>\n\n</div>\n\n    </div>\n <div style=\"text-align:left; margin-top:15px; padding-left:10px; color: #000000; font-size:12px;\">\n       <b>Note:</b> &nbsp (OWL) indicates facilities operating without a licence.\n    </div>\n\n</div>"
