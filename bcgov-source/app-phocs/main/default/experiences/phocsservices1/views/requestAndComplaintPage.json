        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<div style=\"margin:auto;  \">\n\n<!-- Heading Section -->\n    <div style=\"padding:20px 0 10px 10px;\">\n        <h1 style=\"margin:0;\"><b>How can we help?</b></h1> <br/>\n\n        <p style=\"margin:0; color: #000000; font-size :14px\">Use this form to contact our team regarding concerns, questions, or requests for information.</p> <br/>\n        <p style=\"margin:0; color: #000000; font-size :14px\">Depending on the nature of your inquiry, we can:</p> <br/>\n        \n        <div style=\"margin-top:8px; color:#000000; font-size:14px; line-height:1.5;\">\n    <div style=\"margin:0;\">\n        <span style=\"display:inline-block; width:12px;\">•</span>\n        <span>Provide information about programs, services, policies, or requirements.</span>\n    </div>\n\n    <div style=\"margin:0;\">\n        <span style=\"display:inline-block; width:12px;\">•</span>\n        <span>Help you locate publicly available information or resources.</span>\n    </div>\n\n    <div style=\"margin:0;\">\n        <span style=\"display:inline-block; width:12px;\">•</span>\n        <span>Review and respond to concerns about potential issues that may require assessment or investigation.</span> \n            </div> <br/>\n</div>\n        \n        <p style=\"margin:0; color: #000000; font-size :14px\">Please select the option that best describes your reason for contacting us. This will help us direct your submission to the appropriate team and respond\nas efficiently as possible.</p>\n\n    </div>"
          },
