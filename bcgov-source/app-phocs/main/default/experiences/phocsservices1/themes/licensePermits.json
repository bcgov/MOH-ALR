  "customCSS" : "body {\n    width: 100%;\n    overflow-x: hidden;\n    margin: 0;\n    padding: 0;\n}\n.slds-checkbox .slds-checkbox_faux, .slds-checkbox .slds-checkbox--faux {\n    visibility: hidden !important;\n}\n.custom-btn {\n    transition: all 0.25s ease;\n}\n\n/* Hover state */\n.custom-btn:hover {\n    background-color: #003366 !important;  /* Salesforce blue */\n    color: #ffffff !important;             /* white text */\n    border-color: #0070d2 !important;\n}\n\n/********* header****/\n.themeLogo { \n       display: flex; \n       align-items: center; \n       /*gap: 10px; */\n       width: 50%; \n    }\n\n.siteforceServiceBody {\n    display: flex;\n    flex-direction: column;\n    min-height: 100vh;\n}\n\n.siteforceContentArea {\n    flex: 1 0 auto;\n}\n\n.cFooterContainer, footer {\n    flex-shrink: 0;\n}\n.slds-card{\n    border:none !important ; \n}\n.custom-partner-bar {\n        background-color: #003366;\n        text-align: center;\n        width: 100%;\n        border-bottom: 2px solid #FCBA19;\n        border-top: 2px solid #FCBA19;\n        padding: 25px 130px; /* Keeps your text indented on Desktop */\n        box-sizing: border-box; /* Prevents the padding from causing horizontal scrolling */\n   }\n    \n    .custom-partner-text {\n        color: #ffffff; \n        font-size: 14px; \n        margin-bottom: 20px; \n        text-align: left;\n    }\n.partner-logos-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 30px; /* This handles the spacing cleanly instead of using margins */\n}\n\n.partner-logo {\n    height: 40px;\n}\n\n.vch-logo {\n    height: 30px; /* Maintains the slightly smaller height you had for Vancouver Coastal */\n}",
