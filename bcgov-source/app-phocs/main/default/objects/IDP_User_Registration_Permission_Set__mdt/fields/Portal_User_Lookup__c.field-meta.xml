<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Portal_User_Lookup__c</fullName>
    <description>Determine what object to use when looking up a user account/contact record that is used to associate to the user record being created.  This is required for community/portal configurations only.</description>
    <fieldManageability>SubscriberControlled</fieldManageability>
    <label>Portal User Object Lookup</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Account</fullName>
                <default>true</default>
                <label>Account</label>
            </value>
            <value>
                <fullName>Contact</fullName>
                <default>false</default>
                <label>Contact</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
