<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PHOCSDWSComponentIsRequired</fullName>
    <active>true</active>
    <description>Requires Drinking_Water_Component_Name__c to be populated when the related Facility is a DrinkingWaterSystem.</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;PHOCSWaterLabTestRequisition&quot;,
    FacilityName__r.RecordType.DeveloperName = &quot;DrinkingWaterSystem&quot;,
    ISBLANK(Drinking_Water_Component_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Drinking_Water_Component_Name__c</errorDisplayField>
    <errorMessage>Select Water Component associated with this Facility</errorMessage>
</ValidationRule>
