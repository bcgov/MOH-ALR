<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PHOCS_AppliedDateValidation</fullName>
    <active>true</active>
    <description>BLA Applied Date Validation</description>
    <errorConditionFormula>DATEVALUE( AppliedDate ) &gt; TODAY()</errorConditionFormula>
    <errorMessage>Applied Date cannot be in the future.</errorMessage>
</ValidationRule>
