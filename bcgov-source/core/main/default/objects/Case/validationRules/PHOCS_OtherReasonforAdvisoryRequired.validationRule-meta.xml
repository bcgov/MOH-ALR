<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PHOCS_OtherReasonforAdvisoryRequired</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    INCLUDES( ReasonForAdvisory__c , &quot;Other&quot;),
    ISBLANK( OtherReasonforAdvisory__c )
)</errorConditionFormula>
    <errorDisplayField>OtherReasonforAdvisory__c</errorDisplayField>
    <errorMessage>Complete this field.</errorMessage>
</ValidationRule>
